# Servidor
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Base de datos (local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=techlearn

# Base de datos (nube): si se define, tiene prioridad sobre las variables DB_*
# Ejemplo Railway: mysql://usuario:password@host:puerto/railway
DATABASE_URL=

# Cloudinary (subida de imágenes). Se copia desde el panel de Cloudinary: "API environment variable"
CLOUDINARY_URL=

# JWT
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=1h
